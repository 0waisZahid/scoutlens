# These VITE_* values are public build-time configuration; never put secrets here.
# Where the ScoutLens API runs (default shown). Copy to .env to change.
VITE_API_URL=http://127.0.0.1:8000

# Optional: show real player portraits from a source you are licensed to use.
# {id} is replaced by the Transfermarkt player_id. Without it, generated plates are shown.
# VITE_PHOTO_URL_TEMPLATE=https://your.cdn.example/players/{id}.jpg
